<Window x:Class="pz_2_Ridnaya_PR_24._101.Tasks.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pz_2_Ridnaya_PR_24._101.Tasks"
        mc:Ignorable="d"
        Title="Window3" Height="450" Width="800">
    <Grid>
        <Label x:Name="LabelHeading" Content="Текст задачи" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="20"/>
        <Label x:Name="LabelIn" Content="Введите числа:" HorizontalAlignment="Left" Margin="81,172,0,0" VerticalAlignment="Top" FontSize="16"/>
        <Label x:Name="LabelOut" Content="Результат:" HorizontalAlignment="Left" Margin="117,254,0,0" VerticalAlignment="Top" FontSize="16"/>
        <TextBox x:Name="tbInput" HorizontalAlignment="Left" Margin="205,167,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="538" FontSize="16" Height="42" PreviewTextInput="tbInput_PreviewTextInput"/>
        <TextBox x:Name="tbOutput" HorizontalAlignment="Left" Margin="205,254,0,0" TextWrapping="Wrap" Text="Результат" IsReadOnly="True" 
            Focusable="False" VerticalAlignment="Top" Width="538" FontSize="16" Height="39"/>
        <Button x:Name="btnCalculate" Content="Рассчитать" HorizontalAlignment="Center" Margin="0,362,0,0" VerticalAlignment="Top" Click="CalculateButton_Click" FontSize="16" Height="30" Width="102"/>
        <TextBlock x:Name="Task" HorizontalAlignment="Center" Margin="0,72,0,0" TextWrapping="Wrap" Text="В заданной последовательности целых чисел найти максимально длинную подпоследовательность чисел такую, что каждый последующий элемент подпоследовательности делился нацело на предыдущий." VerticalAlignment="Top" Height="68" Width="686" FontSize="14"/>

    </Grid>
</Window>
